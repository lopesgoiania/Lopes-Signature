# ==========================================
# LOPES SIGNATURE - VARIÁVEIS DE AMBIENTE (.env)
# Copie este arquivo para .env e preencha com suas credenciais do Supabase e OpenRouter
# ==========================================

# Supabase API Config (Necessário para salvar produtos, blog e analytics)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# OpenRouter API Key (Necessário para a IA gerar artigos do Blog automaticamente)
OPENROUTER_API_KEY=sk-or-v1-sua-chave-openrouter-aqui

# Site público e exportação HTML (somente conteúdo público é lido no build)
VITE_SITE_URL=https://lopessignature.vercel.app
CONTENT_API_URL=https://lopessignature.vercel.app

# Gestão editorial: mesma lista de administradores autorizados do catálogo
SIGNATURE_ADMIN_EMAILS=

# Opcional: URL privada de deploy hook da hospedagem. Nunca use prefixo VITE_.
# A configuração desse hook será feita após escolher Vercel Pro ou VPS.
SITE_REBUILD_HOOK_URL=
