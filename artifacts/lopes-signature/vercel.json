{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/previa/:path*",
      "destination": "/app.html"
    }
  ],
  "redirects": [
    {
      "source": "/empreendimentos",
      "destination": "/imoveis",
      "permanent": true
    },
    {
      "source": "/lp/bauhaus-vaca-brava",
      "destination": "/imoveis/bauhaus",
      "permanent": true
    },
    {
      "source": "/lp/:id",
      "destination": "/imoveis/:id",
      "permanent": true
    },
    {
      "source": "/property/:id",
      "destination": "/imoveis/:id",
      "permanent": true
    },
    {
      "source": "/conteudos",
      "destination": "/journal",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/previa/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
